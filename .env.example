# Solana cluster: devnet for the MVP. Mainnet is a post-MVP milestone.
SOLANA_CLUSTER=devnet

# Any standard RPC endpoint works (public devnet, Helius free tier, etc.).
SOLANA_RPC_URL=https://api.devnet.solana.com

# Directory holding local keypairs generated by `pnpm setup:devnet`.
# Never commit this directory; it is gitignored.
KEYS_DIR=.keys

# Database.
#   - The worker and scripts default to embedded PGlite (no setup) when unset:
#       pglite://<repo>/.data/kairos-db
#   - The web app (Next.js) REQUIRES a postgres:// URL and fails naming this
#     variable without one: PGlite is single-process and cannot serve the
#     Next.js runtime, so there is no fallback that could work.
#     Use a free Neon database or `docker compose up -d`, then `pnpm db:migrate`.
# DATABASE_URL=postgres://kairos:kairos@localhost:5432/kairos

# --- Indexer tuning (defaults shown) ---
# INDEXER_POLL_MS=8000          # delay between poll cycles
# INDEXER_BACKFILL_LIMIT=100    # signatures fetched on the very first run
# INDEXER_MAX_PAGES=3           # max signature pages per poll when catching up
# INDEXER_TX_DELAY_MS=400       # delay between getTransaction calls

# --- Billing engine (defaults shown) ---
# PULLER_KEYPAIR_PATH=.keys/puller.json  # devnet billing key; KMS in the mainnet milestone
# SCHEDULER_POLL_MS=30000       # how often due subscriptions are checked
# SCHEDULER_BATCH=10            # max charges attempted per cycle
# DISPATCHER_POLL_MS=10000      # webhook dispatch cycle
# WEBHOOK_MAX_ATTEMPTS=5        # delivery attempts before a delivery is dead
# KAIROS_WEBHOOK_ALLOW_PRIVATE=1 # DEV ONLY: allow http:// and private/loopback
#                               # webhook targets (e.g. http://127.0.0.1). Unset in
#                               # production: only https to public hosts is allowed.
# RECONCILER_INTERVAL_MS=3600000 # on-chain account sweep interval
# RECONCILER_PLAN_LIMIT=2000        # max plans re-read per sweep
# RECONCILER_SUBSCRIPTION_LIMIT=5000 # max subscriptions re-read per sweep
#                               # Sweeps are bounded so they cannot grow into an
#                               # unbounded pile of RPC calls; rows cycle by
#                               # staleness. The worker warns when a sweep is capped.

# --- Worker leases (defaults derived from each loop's interval) ---
# Each worker loop (indexer, scheduler, dispatcher, reconciler) runs only while
# it holds a lease in the `worker_leases` table, so a second worker process is a
# warm standby instead of a source of duplicate charges and duplicate webhook
# deliveries. A lease must comfortably outlive one cycle: if a cycle overruns
# its own lease, a standby takes the loop while the first worker is still in it.
# INDEXER_LEASE_TTL_MS=60000
# SCHEDULER_LEASE_TTL_MS=120000
# DISPATCHER_LEASE_TTL_MS=60000
# RECONCILER_LEASE_TTL_MS=900000

# --- Web dashboard / API ---
# AUTH_SECRET=change-me         # HMAC secret for SIWS nonce + session JWTs (REQUIRED in every deployment)
# AUTH_ALLOW_INSECURE_SECRET=1  # DEV ONLY: run without AUTH_SECRET using a well-known insecure key.
#                               # Without this flag, a missing AUTH_SECRET fails closed everywhere.
#                               # Ignored when NODE_ENV=production: there the key is public knowledge,
#                               # so the server refuses to start signing sessions with it.
# AUTH_DOMAIN=app.example.com   # REQUIRED in production: the domain shown in the Sign-In-With-Solana
#                               # message. Locally it falls back to the request host; in production it
#                               # does not, because the Host header is chosen by the caller and trusting
#                               # it would let anyone have this server sign a message that names their
#                               # domain instead of yours.
# TRUSTED_PROXY=1               # set when the app runs behind a proxy/load balancer that sets
#                               # x-forwarded-for. The auth rate limiter uses it for the client
#                               # identity; without it the header is ignored (a forged one would
#                               # otherwise hand out fresh quota per request).
# PULLER_PUBKEY=                # the worker's puller pubkey; shown in dashboard Settings so merchants can add it to their plan's pullers
# NEXT_PUBLIC_SOLANA_CLUSTER=devnet
#                               # REQUIRED in production: same value as SOLANA_CLUSTER, inlined into the
#                               # browser bundle for explorer links and the header badge. A production
#                               # build fails without it rather than labelling mainnet data "devnet".

# --- Landing site ---
# REQUIRED in production: a production build fails without these rather than
# shipping buttons that point at localhost.
#   NEXT_PUBLIC_DASHBOARD_URL  where "Start", "Sign in" and "Become a merchant" point
#   NEXT_PUBLIC_SITE_URL       canonical origin for metadata, sitemap, robots, OG tags
#   NEXT_PUBLIC_NETWORK        mainnet | devnet, drives the network badge
# Unset locally, dev defaults to http://localhost:3000 and :3001.
# NEXT_PUBLIC_DASHBOARD_URL=https://app.example.com
# NEXT_PUBLIC_SITE_URL=https://example.com
# NEXT_PUBLIC_NETWORK=devnet
